# Copy to .env and adjust:  cp .env.example .env

# --- App ---
# local | staging | production  (Swagger docs are disabled in production)
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Security / JWT ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required (>= 32 chars) when ENVIRONMENT is not local.
SECRET_KEY=insecure-dev-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Lifetime of the link in the "forgot password" email
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Frontend ---
# Base URL for links in emails: {FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:3000

# --- Email (SMTP) ---
# Leave SMTP_HOST empty in dev: emails (incl. the reset link) are logged at INFO instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ailusion.local
# STARTTLS after connecting; set false for a plain local SMTP server (e.g. Mailpit on :1025)
SMTP_TLS=true

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ailusion_journey
# TLS: prefer (local Docker, SSL off) | require (any DB over the internet) | verify-full
# (also checks the certificate; needs a CA-signed cert). Also readable as PG_SSLMODE.
POSTGRES_SSLMODE=prefer
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM service (ailusion-journey-llm repo) ---
# Start it with `make api` in the ailusion-journey-llm repo (port 8001).
LLM_SERVICE_URL=http://localhost:8001
LLM_SERVICE_TIMEOUT=120
# How long a conversation stays listed. Match CHECKPOINT_TTL_MINUTES in the LLM service.
CHAT_THREAD_TTL_MINUTES=1440

# --- docker-compose host ports (change if already in use on your machine) ---
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
