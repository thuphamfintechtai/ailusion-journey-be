# Copy to .env and adjust:  cp .env.example .env

# --- App ---
# local | staging | production  (Swagger docs are disabled in production)
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Security / JWT ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required (>= 32 chars) when ENVIRONMENT is not local.
SECRET_KEY=insecure-dev-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ailusion_journey
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM service (ailusion-journey-llm repo) ---
# Start it with `make api` in the ailusion-journey-llm repo (port 8001).
LLM_SERVICE_URL=http://localhost:8001
LLM_SERVICE_TIMEOUT=120
# How long a conversation stays listed. Match CHECKPOINT_TTL_MINUTES in the LLM service.
CHAT_THREAD_TTL_MINUTES=1440

# --- docker-compose host ports (change if already in use on your machine) ---
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
