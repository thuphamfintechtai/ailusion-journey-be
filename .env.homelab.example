# cp .env.homelab.example .env.homelab
# Chạy: docker compose --env-file .env.homelab -f compose.homelab.yaml up -d --build
# SERVICE_API_KEY phải trùng với file cùng tên bên ailusion-journey-llm.

TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=web
WEB_HOST=journey.ailusion.io.vn
API_HOST=journey.api.ailusion.io.vn

# python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production từ chối chuỗi insecure-dev-secret-key-change-me-in-production.
SECRET_KEY=
# openssl rand -hex 32
SERVICE_API_KEY=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ailusion_journey
DB_HOST_PORT=5434
REDIS_HOST_PORT=6380
API_HOST_PORT=8000

# Để trống SMTP_HOST: link quên mật khẩu chỉ ghi vào log container api.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ailusion.io.vn
SMTP_TLS=true
